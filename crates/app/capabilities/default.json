{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events and the folder picker only. File access goes through Aurora's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "core:window:allow-set-effects"
  ]
}
